# Copy to .env and fill in. Never commit .env.

# Required: Discord Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Optional: Spotify links (https://developer.spotify.com/dashboard). The app owner needs Spotify Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: lets the bot read playlists you own/collaborate on. Get it with: python -m bot.tools.spotify_auth
SPOTIFY_REFRESH_TOKEN=

# Optional: better /random and autoplay suggestions (https://www.last.fm/api/account/create)
LASTFM_API_KEY=
